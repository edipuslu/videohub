# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY

# Random long secret used to sign VideoHub session cookies.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# Single Uslu Digital admin login. There is no admins table — the master
# admin account is defined entirely by these two variables. Generate the
# hash with: npm run hash-password -- "your-password"
#
# IMPORTANT: Next.js expands $VAR syntax in .env files, and bcrypt hashes
# are full of "$" characters. Escape every "$" as "\$" or the hash gets
# silently mangled and login will fail. Example:
#   $2a$12$abc...   ->   \$2a\$12\$abc...
ADMIN_VIDEOHUB_ID=uslu-admin
ADMIN_PASSWORD_HASH=YOUR_BCRYPT_HASH_WITH_DOLLAR_SIGNS_ESCAPED
